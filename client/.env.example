# ==============================================================================
# Cấu hình URL Backend Node.js cho Frontend khi deploy lên Firebase
# ==============================================================================

# Nếu Node server chạy trên Render, Cloud Run, VPS hoặc Server riêng:
# Nhập đầy đủ URL (không có dấu gạch chéo ở cuối)
VITE_API_URL=https://your-node-server.onrender.com

# Nếu deploy cùng domain hoặc dùng Firebase Hosting rewrites (/api/**):
# Để trống biến này thì client sẽ tự động gọi relative path /api
# VITE_API_URL=
