{
  "name": "data-crawl-workspace",
  "version": "1.0.0",
  "private": true,
  "description": "Monorepo workspace for Data Crawl (Client + Server)",
  "scripts": {
    "dev": "npm run dev:client",
    "dev:all": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "build": "npm run build --prefix client",
    "build:client": "npm run build --prefix client",
    "deploy": "npm run deploy:firebase",
    "deploy:firebase": "npm run build --prefix client && npx firebase-tools deploy --only hosting --project anh-cao-keu",
    "start:server": "npm start --prefix server",
    "dev:server": "npm run dev --prefix server",
    "dev:client": "npm run dev --prefix client",
    "sync:nchmf": "node server/autoSyncNCHMF.js",
    "sync:watch": "node server/autoSyncNCHMF.js --watch --interval 60",
    "sync:hymetnet": "node server/autoSyncHymetnet.js",
    "sync:hymetnet:watch": "node server/autoSyncHymetnet.js --watch --interval 120"
  }
}
