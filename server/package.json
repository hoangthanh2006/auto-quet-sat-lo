{
  "name": "daihoidang-scraper-server",
  "version": "1.0.0",
  "description": "Backend server for DaiHoiDang Scraper",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "start": "node index.js",
    "build": "bash render-build.sh",
    "postinstall": "npx puppeteer browsers install chrome || true",
    "dev": "node --watch index.js",
    "sync:nchmf": "node autoSyncNCHMF.js",
